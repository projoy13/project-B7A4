model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String

  role   Role       @default(CUSTOMER)
  status UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Provider's gear
  gearItems GearItem[]

  // Customer's rentals
  rentals RentalOrder[]

  // Customer reviews
  reviews Review[]

  @@map("users")
}
